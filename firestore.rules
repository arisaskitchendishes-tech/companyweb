rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    // Customers can place an order and track it by its (unguessable) code.
    // Only admins can list all orders or change them.
    match /orders/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.status == 'new'
                    && request.resource.data.id == id
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 40
                    && str(request.resource.data.customer.name, 80)
                    && str(request.resource.data.customer.phone, 20)
                    && request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.total < 500000
                    && request.resource.data.mode in ['delivery', 'pickup'];
      allow update, delete: if isAdmin();
    }

    match /bookings/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.id == id
                    && str(request.resource.data.customer.name, 80)
                    && str(request.resource.data.customer.phone, 20)
                    && request.resource.data.guests is int
                    && request.resource.data.guests > 0
                    && request.resource.data.guests <= 1000;
      allow update, delete: if isAdmin();
    }

    // Sold-out items etc. Everyone reads, admins write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin list: add documents by hand in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
